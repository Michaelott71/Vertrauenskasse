---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import AnalyticsNoscript from '../components/AnalyticsNoscript.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { useTranslations, localizedPath, type Lang } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const canonicalPath = localizedPath(lang, Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ?? t('meta.title')}</title>
    <meta name="description" content={description ?? t('meta.description')} />
    <link rel="canonical" href={`https://majorsgolfbox.de${canonicalPath}`} />
    <link rel="alternate" hreflang="de" href="https://majorsgolfbox.de/de" />
    <link rel="alternate" hreflang="en" href="https://majorsgolfbox.de/en" />
    <link rel="alternate" hreflang="x-default" href="https://majorsgolfbox.de/de" />
    <meta property="og:title" content={title ?? t('meta.title')} />
    <meta property="og:description" content={description ?? t('meta.description')} />
    <meta property="og:type" content="website" />
    <Analytics />
  </head>
  <body>
    <AnalyticsNoscript />
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
