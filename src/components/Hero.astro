---
import { useTranslations, type Lang } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" id="hero">
  <div class="container hero__inner">
    <p class="eyebrow eyebrow--light">{t('hero.eyebrow')}</p>
    <h1 class="hero__headline">{t('hero.headline')}</h1>
    <p class="hero__subline">{t('hero.subline')}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={site.bookingUrl} data-cta="book-now">{t('hero.ctaPrimary')}</a>
      <a class="btn btn--secondary" href="#contact">{t('hero.ctaSecondary')}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(160deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: #fff;
    padding: 6rem 0 5rem;
  }

  .eyebrow--light {
    color: var(--color-accent-light);
  }

  .hero__headline {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    max-width: 16ch;
  }

  .hero__subline {
    max-width: 60ch;
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
