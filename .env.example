# Kopieren nach .env und Werte anpassen. .env wird NICHT committed (siehe .gitignore).

# Mit `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` erzeugen
DJANGO_SECRET_KEY=changeme-generate-a-real-random-secret-key

DJANGO_DEBUG=False

# Kommagetrennt: Domain(s), Tailscale-Name oder IP, unter der die App erreichbar ist
DJANGO_ALLOWED_HOSTS=vertrauenskasse.beispiel.de

# Nur noetig, wenn per Domain + HTTPS erreichbar (siehe DJANGO_ALLOWED_HOSTS)
DJANGO_CSRF_TRUSTED_ORIGINS=https://vertrauenskasse.beispiel.de

DJANGO_DB_PATH=/app/data/db.sqlite3

# DATEV-Kontenrahmen fuer den Buchhaltungs-Export: SKR03 oder SKR04
# (noch mit dem Steuerberater final zu klaeren, siehe README)
DATEV_KONTENRAHMEN=SKR03

# Ohne eigene Domain (z.B. reines Tailscale-VPN oder lokales Netz): leer lassen
# bzw. SITE_ADDRESS=:80 (nur HTTP, Tailscale verschluesselt bereits selbst)
# Mit eigener Domain (DNS zeigt auf diesen Server, Port 443 offen): automatisches HTTPS via Let's Encrypt
SITE_ADDRESS=:80
